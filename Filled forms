<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exclusive Academic Activity Tracker</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #2c3e50;
            --accent-blue: #3498db;
            --header-blue: #4e5cc4;
            --bg-gray: #f4f7f9;
        }

        body {
            background-color: var(--bg-gray);
            padding: 40px 15px;
            font-family: 'Segoe UI', sans-serif;
        }

        .container-custom { max-width: 1000px; margin: 0 auto; }

        /* Tier 1: Primary Horizontal Bars */
        .primary-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            margin-bottom: 15px;
            overflow: hidden;
            border: 1px solid #dee2e6;
        }

        .primary-header {
            background: var(--header-blue);
            color: white;
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: background 0.3s;
        }

        .primary-header:hover { background: #3f4bb0; }

        /* Tier 2: Sub-Category Dropdowns */
        .sub-category-container {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease-out, padding 0.3s;
            background: #fff;
        }

        .sub-category-container.show { max-height: 5000px; padding: 20px; }

        .sub-row {
            border: 1px solid #e9ecef;
            border-radius: 8px;
            margin-bottom: 10px;
            background: #fdfdfd;
        }

        .sub-header {
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-weight: 600;
        }

        /* Tier 3: Entries */
        .entry-list {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-in-out;
            background: #f8f9fa;
        }

        .entry-list.show { max-height: 1000px; padding: 10px 20px; border-top: 1px solid #eee; }

        .entry-item {
            padding: 8px 15px;
            margin: 5px 0;
            background: white;
            border-left: 4px solid var(--accent-blue);
            border-radius: 4px;
            display: flex;
            align-items: center;
            font-size: 0.9rem;
        }

        .rotate { transition: transform 0.3s; }
        .expanded .rotate { transform: rotate(180deg); }
    </style>
</head>
<body>

<div class="container-custom">
    <div class="text-center mb-5">
        <h2 class="fw-bold" style="color: var(--primary-dark);">Faculty & Departmental Dashboard</h2>
    </div>

    <div id="masterContainer"></div>
</div>

<script>
    const primaryHeadings = [
        "Non-teaching Staff Profile Details",
        "Faculty Participation",
        "MOOC's/Short Term Course/Course Completion",
        "Events Organized by Department",
        "Faculty Awards and Achievements",
        "Sponsored Research/Grant Received/Consultancy",
        "Research Publication - Journals",
        "Research Publication - Conference Publication",
        "Research Publication - Book and Book Chapters",
        "Patents",
        "M.Tech/Ph.D Guided",
        "Resource Person"
    ];

    const facultySubOptions = ["FDP", "Workshop", "Conference", "STTP", "Seminar", "Webinar", "Lecture Series", "Symposium", "Other"];

    function render() {
        const container = document.getElementById('masterContainer');
        container.innerHTML = primaryHeadings.map((heading, pIndex) => {
            const subs = (heading === "Faculty Participation") ? facultySubOptions : ["Recent Activity", "Archived Records"];

            return `
                <div class="primary-card" id="p-card-${pIndex}">
                    <div class="primary-header" onclick="togglePrimary(${pIndex})">
                        <h5 class="m-0 fs-6 fw-bold">${heading}</h5>
                        <i class="fas fa-chevron-down rotate"></i>
                    </div>

                    <div class="sub-category-container" id="p-content-${pIndex}">
                        ${subs.map((sub, sIndex) => `
                            <div class="sub-row">
                                <div class="sub-header" onclick="toggleSub(${pIndex}, ${sIndex}, event)">
                                    <span>${sub}</span>
                                    <i class="fas fa-plus rotate fa-xs"></i>
                                </div>
                                <div class="entry-list" id="s-content-${pIndex}-${sIndex}">
                                    <div class="entry-item"><i class="fas fa-check-circle text-success me-2"></i>Expert AI Workshop</div>
                                    <div class="entry-item"><i class="fas fa-check-circle text-success me-2"></i>Advanced Python Series</div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }).join('');
    }

    // Function to handle the 12 Primary Blue Bars
    function togglePrimary(index) {
        const allContent = document.querySelectorAll('.sub-category-container');
        const allHeaders = document.querySelectorAll('.primary-header');
        const targetContent = document.getElementById(`p-content-${index}`);
        const targetHeader = allHeaders[index];

        const isOpening = !targetContent.classList.contains('show');

        // Close all primary sections first
        allContent.forEach((el, i) => {
            el.classList.remove('show');
            allHeaders[i].classList.remove('expanded');
        });

        // Open only the clicked one if it wasn't already open
        if (isOpening) {
            targetContent.classList.add('show');
            targetHeader.classList.add('expanded');
        }
    }

    // Function to handle the internal Sub-Categories (FDP, Workshop, etc.)
    function toggleSub(pIdx, sIdx, event) {
        event.stopPropagation();
        
        // Find all sub-entries within this specific primary card
        const parentCard = document.getElementById(`p-content-${pIdx}`);
        const allSubContents = parentCard.querySelectorAll('.entry-list');
        const allSubHeaders = parentCard.querySelectorAll('.sub-header');
        
        const targetSub = document.getElementById(`s-content-${pIdx}-${sIdx}`);
        const targetHeader = allSubHeaders[sIdx];
        
        const isOpening = !targetSub.classList.contains('show');

        // Close all other sub-categories in this group
        allSubContents.forEach((el, i) => {
            el.classList.remove('show');
            allSubHeaders[i].classList.remove('expanded');
            const icon = allSubHeaders[i].querySelector('.fa-minus');
            if(icon) { icon.classList.replace('fa-minus', 'fa-plus'); }
        });

        // Open clicked one
        if (isOpening) {
            targetSub.classList.add('show');
            targetHeader.classList.add('expanded');
            targetHeader.querySelector('.fas').classList.replace('fa-plus', 'fa-minus');
        }
    }

    render();
</script>

</body>
</html>
