<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Academic Tracker – Enhanced</title>

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<style>
body {
    background: #f8fafc;
    padding: 40px 15px;
    font-family: Inter, sans-serif;
}

.container-custom {
    max-width: 1000px;
    margin: auto;
}

/* PRIMARY CARD */
.primary-card {
    background: #fff;
    border-radius: 14px;
    border: 2px solid var(--card-color);
    margin-bottom: 16px;
    overflow: hidden;
}

.primary-header {
    padding: 18px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    color: var(--card-color);
}

.primary-header h5 {
    margin: 0;
    font-weight: 550;
}

.primary-header small {
    display: block;
    margin-top: 4px;
    color: #64748b;
}

/* GRID ACCORDION (NO HEIGHT BUGS) */
.primary-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
}

.primary-card.open .primary-body {
    grid-template-rows: 1fr;
}

.primary-body > div {
    overflow: hidden;
}

/* INNER CONTENT */
.inner-content {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fafafa;
}

/* SUB ROW */
.sub-row {
    background: white;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
}

.sub-header {
    padding: 12px 20px;
    font-weight: 550;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
}

/* SUB ACCORDION */
.entry-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
}

.sub-row.open .entry-wrapper {
    grid-template-rows: 1fr;
}

.entry-wrapper > div {
    overflow: hidden;
}

.entry-padding {
    padding: 0 20px 15px;
}

.entry-item {
    padding: 10px 14px;
    margin-top: 6px;
    border-left: 4px solid var(--card-color);
    border-radius: 6px;
    background: #fff;
    font-size: 0.9rem;
}

.rotate {
    transition: transform 0.3s ease;
}

.primary-card.open .rotate,
.sub-row.open .rotate {
    transform: rotate(180deg);
}
</style>
</head>

<body>

<div class="container-custom" id="app"></div>

<script>
const forms = [
    { title: "Non-teaching Staff Profile Details", color: "#64748b" },
    { title: "Faculty Participation", color: "#22c55e" },
    { title: "MOOC's/Short Term Course/Course Completion", color: "#eab308" },
    { title: "Events Organized by Department", color: "#ef4444" },
    { title: "Faculty Awards and Achievements", color: "#06b6d4" },
    { title: "Sponsored Research/Grant Received/Consultancy", color: "#8b5cf6" },
    { title: "Research Publication - Journals", color: "#0ea5e9" },
    { title: "Research Publication - Conference Publication", color: "#3b82f6" },
    { title: "Research Publication - Book and Book Chapters", color: "#f59e0b" },
    { title: "Patents", color: "#14b8a6" },
    { title: "M.Tech/Ph.D Guided", color: "#06b6d4" },
    { title: "Resource Person", color: "#ec4899" }
];

document.getElementById("app").innerHTML = forms.map(f => `
<div class="primary-card" style="--card-color:${f.color}">
    <div class="primary-header">
        <div>
            <h5>${f.title}</h5>
            <small>3 forms filled</small>
        </div>
        <i class="fas fa-chevron-down rotate"></i>
    </div>

    <div class="primary-body">
        <div class="inner-content">
            ${["Recent Activity", "General Records"].map(s => `
            <div class="sub-row">
                <div class="sub-header">
                    <span>${s}</span>
                    <i class="fas fa-plus rotate fa-xs"></i>
                </div>

                <div class="entry-wrapper">
                    <div>
                        <div class="entry-padding">
                            <div class="entry-item">Verified Entry 01</div>
                            <div class="entry-item">Verified Entry 02</div>
                        </div>
                    </div>
                </div>
            </div>
            `).join("")}
        </div>
    </div>
</div>
`).join("");

/* EVENTS */
document.querySelectorAll(".primary-header").forEach(h => {
    h.onclick = () => {
        document.querySelectorAll(".primary-card").forEach(c => {
            if (c !== h.parentElement) c.classList.remove("open");
        });
        h.parentElement.classList.toggle("open");
    };
});

document.querySelectorAll(".sub-header").forEach(h => {
    h.onclick = e => {
        e.stopPropagation();
        const row = h.parentElement;
        row.classList.toggle("open");
    };
});
</script>

</body>
</html>
